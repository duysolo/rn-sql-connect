{
  "name": "rn-sql-connect-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for rn-sql-connect, the React Native native SDK for Firebase SQL Connect (Data Connect)",
  "workspaces": [
    "packages/*",
    "example"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "test": "jest",
    "emulator": "firebase emulators:start --only dataconnect,auth --project demo-rn-sql-connect --config example/firebase.json",
    "example:android": "npm run android --workspace rn-sql-connect-example",
    "example:ios": "npm run ios --workspace rn-sql-connect-example",
    "example:start": "npm run start --workspace rn-sql-connect-example",
    "vendor:sync": "node scripts/sync-vendored-dataconnect.mjs",
    "vendor:check": "node scripts/sync-vendored-dataconnect.mjs --check",
    "verify:package": "node scripts/verify-package.mjs",
    "publish:main": "npm publish -w rn-sql-connect"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "react": "^19.2.8",
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.40.17",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
